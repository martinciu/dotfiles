#!/opt/homebrew/bin/bash
# Emit a Nerd Font globe glyph (U+F0AC, nf-fa-globe) when any currently-
# attached tmux client traces back to an `sshd` (or `sshd-session`) or
# `mosh-server` ancestor process. Otherwise emit nothing. Intended for use
# inside the left-side
# session chip via `#(...)` in tmux's `status-left`.
#
# Detection is server-wide (any attached client remote-rooted -> indicator
# on) with one per-client exception (#366): clients whose session carries
# the @phone_twin marker are skipped, so the globe reads "a remote client
# OTHER than the phone is attached" — a Moshi user already knows their
# session is remote, and the Mac shouldn't pin the phone's own attach.
#
# Mosh sessions root in `mosh-server` (daemonized, directly under launchd),
# not `sshd` — detected via the same match set, same glyph: the pin means
# "a remote client is attached", transport-agnostic.

set -eu
set -o pipefail

# Globe glyph as raw UTF-8 bytes — same byte-emission style as
# tmux-git-status; avoids editor-dependent literal embedding.
glyph=$(printf '\xef\x82\xac')   # U+F0AC nf-fa-globe

. "${BASH_SOURCE[0]%/*}/_remote-ancestry"

clients=$(tmux list-clients -F '#{client_pid} #{client_session}' 2>/dev/null || true)
[ -z "$clients" ] && exit 0

while IFS=' ' read -r pid session; do
  [ -z "$pid" ] && continue
  # Phone twins are excluded by design (#366): the Moshi client in its
  # bar-less twin is remote by construction; the globe should only pin
  # other remote clients. Bare -t: show-option rejects the "=" prefix
  # (tmux 3.7b), and the session name comes straight from list-clients.
  if [ -n "$session" ] && \
     [ "$(tmux show-option -t "$session" -qv @phone_twin 2>/dev/null)" = 1 ]; then
    continue
  fi
  if ancestry_is_remote "$pid"; then
    printf '%s ' "$glyph"
    exit 0
  fi
done <<<"$clients"

exit 0
