{
  "$schema": "https://lnav.org/schemas/config-v1.schema.json",
  "ui": {
    "theme-defs": {
      "nord": {
        "vars": {
          "bg0":           "#2e3440",
          "bg0_h":         "#3b4252",
          "bg1":           "#3b4252",
          "bg2":           "#434c5e",
          "bg3":           "#4c566a",
          "bg4":           "#4c566a",
          "fg0":           "#eceff4",
          "fg1":           "#d8dee9",
          "fg2":           "#d8dee9",
          "fg3":           "#e5e9f0",
          "fg4":           "#d8dee9",
          "gray":          "#4c566a",
          "red":           "#bf616a",
          "green":         "#a3be8c",
          "yellow":        "#ebcb8b",
          "blue":          "#5e81ac",
          "purple":        "#b48ead",
          "aqua":          "#8fbcbb",
          "orange":        "#d08770",
          "bright_red":    "#bf616a",
          "bright_green":  "#a3be8c",
          "bright_yellow": "#ebcb8b",
          "bright_blue":   "#81a1c1",
          "bright_purple": "#b48ead",
          "bright_aqua":   "#88c0d0",
          "bright_orange": "#d08770",
          "semantic_highlight_color": "semantic()"
        },
        "styles": {
          "text":                  { "color": "$fg1", "background-color": "$bg0" },
          "alt-text":              { "background-color": "$bg1" },
          "ok":                    { "color": "$green",  "bold": true },
          "error":                 { "color": "$red",    "bold": true },
          "warning":               { "color": "$yellow", "bold": true },
          "info":                  { "color": "$aqua",   "bold": true },
          "hidden":                { "color": "$bg3" },
          "adjusted-time":         { "color": "$purple" },
          "skewed-time":           { "color": "$yellow" },
          "offset-time":           { "color": "$aqua" },
          "invalid-msg":           { "color": "$bright_red" },
          "focused":               { "color": "$bg0", "background-color": "$fg1" },
          "disabled-focused":      { "color": "$bg0", "background-color": "$bg3" },
          "popup":                 { "color": "$fg1", "background-color": "$bg1" },
          "popup-border":          { "color": "$bg3", "background-color": "$bg1" },
          "scrollbar":             { "color": "$fg1", "background-color": "$bg2" },
          "h1":                    { "color": "$bright_yellow", "bold": true, "underline": true },
          "h2":                    { "color": "$bright_orange", "bold": true, "underline": true },
          "h3":                    { "color": "$bright_purple", "underline": true },
          "h4":                    { "underline": true },
          "h5":                    { "underline": true },
          "h6":                    { "underline": true },
          "hr":                    { "color": "$bg3" },
          "hyperlink":             { "color": "$bright_blue", "underline": true },
          "list-glyph":            { "color": "$yellow" },
          "breadcrumb":            { "color": "$gray", "bold": true },
          "table-border":          { "color": "$bg3" },
          "table-header":          { "bold": true },
          "quote-border":          { "color": "$bg3", "background-color": "$bg1" },
          "quoted-text":           { "background-color": "$bg1" },
          "snippet-border":        { "color": "$bright_aqua" },
          "indent-guide":          { "color": "$bg2" },
          "selected-text":         { "background-color": "$bg2" },
          "fuzzy-match":           { "color": "$bright_yellow", "underline": true },
          "cursor-line":           { "color": "$fg0", "background-color": "$bg1", "bold": true },
          "highlight":             { "color": "$bright_yellow", "bold": true },
          "search":                { "color": "$bg0", "background-color": "$bright_yellow" },
          "status":                { "color": "$fg1", "background-color": "$bg1" },
          "warn-status":           { "color": "$yellow", "background-color": "$bg1" },
          "alert-status":          { "color": "$red", "background-color": "$bg1" },
          "active-status":         { "color": "$green", "background-color": "$bg1", "bold": true },
          "active-status2":        { "color": "$green", "background-color": "$bg1" },
          "status-title":          { "color": "$bg0", "background-color": "$aqua", "bold": true },
          "status-subtitle":       { "color": "$bg0", "background-color": "$blue" },
          "status-info":           { "color": "$bg0", "background-color": "$bright_blue" },
          "status-hotkey":         { "color": "$bright_yellow", "underline": true },
          "status-title-hotkey":   { "color": "$bright_yellow", "background-color": "$aqua", "underline": true },
          "status-disabled-title": { "color": "$gray", "background-color": "$bg1" },
          "inline-code":           { "color": "$bright_orange", "background-color": "$bg1" }
        },
        "syntax-styles": {
          "quoted-code":      { "color": "$fg1", "background-color": "$bg1" },
          "code-border":      { "color": "$bg3", "background-color": "$bg1" },
          "keyword":          { "color": "$red" },
          "string":           { "color": "$green" },
          "comment":          { "color": "$gray", "italic": true },
          "doc-directive":    { "color": "$bright_aqua" },
          "variable":         { "color": "$blue" },
          "symbol":           { "color": "$purple" },
          "re-special":       { "color": "$bright_aqua" },
          "re-repeat":        { "color": "$bright_yellow" },
          "diff-delete":      { "color": "$red" },
          "diff-add":         { "color": "$green" },
          "diff-section":     { "color": "$bright_yellow" },
          "file":             { "color": "$blue" },
          "null":             { "color": "$gray", "bold": true },
          "ascii-control":    { "color": "$bright_red" },
          "non-ascii":        { "color": "$bright_yellow" },
          "number":           { "color": "$purple" },
          "type":             { "color": "$bright_yellow" },
          "function":         { "color": "$bright_green" },
          "separators-references-accessors": { "color": "$gray" }
        }
      }
    }
  }
}
