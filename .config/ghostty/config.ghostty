# Ghostty's parser does NOT strip trailing inline `#` comments from values
# (boolean parsing is strict); comments must live on their own lines.

# ─── Theme ────────────────────────────────────
# Theme + theme-specific overrides live in theme.ghostty (machine-local
# symlink → theme-solarized.ghostty | theme-mocha.ghostty). Swap via
# `theme-set <name>`; reload via cmd+ctrl+shift+r or `ghostty +reload`.
config-file = theme.ghostty

# ─── Font ─────────────────────────────────────
# Font family lives in font.ghostty (machine-local symlink →
# font-{jetbrains,fira,cascadia,monaspace,iosevka,…}.ghostty).
# Size lives in font-size.ghostty (machine-local real file, seeded by
# bootstrap at 14). Weight lives in font-weight.ghostty (machine-local
# real file; empty by default — font's own regular is used). All swap
# via `font-set <name> [<size>] [<weight>]`; reload via
# cmd+ctrl+shift+r or `ghostty +reload`.
config-file = font.ghostty
config-file = font-size.ghostty
config-file = font-weight.ghostty
# Slightly bolder strokes on macOS retina.
font-thicken = true

# ─── Window appearance ────────────────────────
background-opacity = 0.92
background-blur = macos-glass-clear
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
# Padding area inherits the live background instead of the theme background.
window-padding-color = extend
# Use the wider P3 color space on modern Macs.
window-colorspace = display-p3
# Bold text uses the bright palette — more visual variety in ls/prompts/logs.
bold-is-bright = true
# Native macOS tab bar — auto-hides when only one tab is open.
macos-titlebar-style = transparent
# Restore tabs/splits on reopen.
window-save-state = always
mouse-hide-while-typing = true
cursor-style = block
cursor-style-blink = false
# Cursor inverts whatever's underneath instead of using a fixed color.
# (Less visually dramatic with `bar` than `block`, but still useful.)
cursor-invert-fg-bg = true
# Bumps cursor stroke weight by N px — pairs well with bar cursor on retina.
adjust-cursor-thickness = 2
# Dim non-focused splits so the active one is obvious at a glance.
unfocused-split-opacity = 0.85
# Show live dimensions in the corner while resizing the window.
resize-overlay = always
# Skip the "are you sure?" dialog when closing a tab/split.
confirm-close-surface = false

# ─── macOS app icon ───────────────────────────
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = #ffffff
macos-icon-screen-color = #1a1b26,#7aa2f7

# ─── Shell integration ────────────────────────
shell-integration = detect
# Defaults plus `sudo` so sudo preserves terminfo/cursor/title. Default leaves sudo off.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

# ─── Working directory ────────────────────────
# Always open new surfaces in $HOME — fresh start on cmd+t, no project leakage.
# `working-directory` alone isn't enough: the three `*-inherit-working-directory`
# flags default to true and take precedence, so they must also be disabled.
working-directory = home
tab-inherit-working-directory = false
window-inherit-working-directory = false
split-inherit-working-directory = false

# ─── Left Option = Alt (right Option = Polish) ─
# Ghostty distinguishes left and right Option natively. `left` means:
# left-Option emits ESC+key for TUIs (atuin row-N shortcuts, fish/readline
# word-jump, etc.) while right-Option keeps producing Polish diacritics
# via the OS layout (ą, ć, ę, ł, ń, ó, ś, ź, ż). Why this and not
# right_cmd: Ghostty 1.3 keybinds do not accept sided modifiers
# (`right_cmd+x` is `error.InvalidFormat`), and `key-remap = right_cmd=alt`
# only changes keybind matching, not byte emission, so the modifier was
# silently dropped and apps only saw the bare key. macos-option-as-alt
# operates at the byte-emission layer and is the supported way to do this.
macos-option-as-alt = left

# ─── Keybindings (config reload) ──────────────
# Three-modifier combo to avoid clashes with launchers / menu shortcuts.
# (The Polish-Pro layout broke the default `cmd+shift+,` for this user.)
keybind = cmd+ctrl+shift+r=reload_config

# ─── Keybindings (scrolling) ──────────────────
# Scrolls Ghostty's buffer and passes the key through to apps (e.g. Claude Code).
# Note: doesn't work inside tmux — tmux snaps the view back immediately.
keybind = unconsumed:page_up=scroll_page_up
keybind = unconsumed:page_down=scroll_page_down

# ─── Keybindings (splits) ─────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down


alpha-blending = native
macos-window-shadow = true
# All bell channels disabled (audio/system/border/attention/title).
# Empty value is explicit: keeps intent visible if Ghostty defaults change.
bell-features =


